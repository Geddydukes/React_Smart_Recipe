# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY variable contains the PATH to the node executable.
#
# Customize the NODE_BINARY variable here.
# For example, to use nvm with brew, add the following line
# . "$(brew --prefix nvm)/nvm.sh" --no-use
# Attempt to find Node using command -v
NODE_BINARY_CMD=$(command -v node)

if [ -n "$NODE_BINARY_CMD" ]; then
  export NODE_BINARY="$NODE_BINARY_CMD"
else
  # Fallback 1: Check common nvm path
  NVM_DIR="$HOME/.nvm"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    # Source nvm and try to get the path to the current node version
    . "$NVM_DIR/nvm.sh" --no-use > /dev/null 2>&1 # Suppress output and errors from nvm.sh
    NVM_NODE_PATH_CMD=$(command -v node) # nvm should have set up the path now
    if [ -n "$NVM_NODE_PATH_CMD" ]; then
      export NODE_BINARY="$NVM_NODE_PATH_CMD"
    elif [ -L "$NVM_DIR/current/bin/node" ]; then # Check if 'current' alias exists
      export NODE_BINARY="$NVM_DIR/current/bin/node"
    elif [ -n "$(ls -v $NVM_DIR/versions/node | tail -n 1)" ]; then # Get latest installed version
        LATEST_NVM_NODE_VERSION=$(ls -v $NVM_DIR/versions/node | tail -n 1)
        if [ -f "$NVM_DIR/versions/node/$LATEST_NVM_NODE_VERSION/bin/node" ]; then
            export NODE_BINARY="$NVM_DIR/versions/node/$LATEST_NVM_NODE_VERSION/bin/node"
        fi
    fi
  fi

  # Fallback 2: Check /usr/local/bin/node if NODE_BINARY is still not set
  if [ -z "$NODE_BINARY" ] && [ -x "/usr/local/bin/node" ]; then
    export NODE_BINARY="/usr/local/bin/node"
  fi

  # Fallback 3: Check /opt/homebrew/bin/node (for Apple Silicon Macs with Homebrew)
  if [ -z "$NODE_BINARY" ] && [ -x "/opt/homebrew/bin/node" ]; then
    export NODE_BINARY="/opt/homebrew/bin/node"
  fi
fi

# If NODE_BINARY is still not set, log an error or set a default that might fail clearly
if [ -z "$NODE_BINARY" ]; then
  echo "warning: Node.js binary not found. Please ensure Node.js is installed and in your PATH." >&2
  # Optionally, set to a dummy value to make it clear in Xcode logs if it's missing
  # export NODE_BINARY="/path/to/node/not/found"
fi
